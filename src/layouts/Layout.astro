---
import "../styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { languages, locales, defaultLocale, type Locale } from "../i18n/languages";
import { getDictionary } from "../i18n/utils";
import OwlMark from "../components/OwlMark.astro";

interface Props {
	locale: Locale;
	title?: string;
	description?: string;
	currentPath?: string;
}

const { locale, title, description, currentPath = "/" } = Astro.props;
const dict = getDictionary(locale);

const pageTitle = title ?? dict.meta.title;
const pageDescription = description ?? dict.meta.description;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang={locale}>
	<head>
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem("theme");
					var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
					var isDark = stored === "dark" || (stored !== "light" && prefersDark);
					document.documentElement.classList.toggle("dark", isDark);
				} catch (e) {}
				document.documentElement.classList.add("js-reveal");
			})();
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="interpolation" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

		{locales.map((loc) => (
			<link rel="alternate" hreflang={loc} href={new URL(getRelativeLocaleUrl(loc, currentPath === "/" ? "" : currentPath), Astro.site)} />
		))}
		<link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl(defaultLocale, ""), Astro.site)} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Interpolation Calculator Online" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
		<meta property="og:locale" content={locale} />
		<meta property="og:image" content={new URL("/web-app-manifest-512x512.png", Astro.site)} />
		<meta property="og:image:width" content="512" />
		<meta property="og:image:height" content="512" />
		<meta property="og:image:alt" content={pageTitle} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={new URL("/web-app-manifest-512x512.png", Astro.site)} />

		<script type="application/ld+json" is:inline set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebApplication",
			name: "Interpolation Calculator",
			url: new URL(Astro.url.pathname, Astro.site).toString(),
			applicationCategory: "UtilitiesApplication",
			operatingSystem: "Any (runs in browser)",
			description: pageDescription,
			offers: {
				"@type": "Offer",
				price: "0",
				priceCurrency: "USD",
			},
			featureList: [
				"Linear interpolation calculator",
				"Logarithmic interpolation calculator",
				"Double (bilinear) interpolation calculator",
				"Step-by-step results",
			],
		})} />

		{dict.faq?.items?.length ? (
			<script type="application/ld+json" is:inline set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "FAQPage",
				mainEntity: dict.faq.items.map((item) => ({
					"@type": "Question",
					name: item.q,
					acceptedAnswer: {
						"@type": "Answer",
						text: item.a,
					},
				})),
			})} />
		) : null}

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="preload"
			as="style"
			href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
			rel="stylesheet"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
				rel="stylesheet"
			/>
		</noscript>
	</head>
	<body class="bg-canvas text-ink antialiased">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-3.5 focus:py-2 focus:text-ink-contrast focus:shadow-lg"
		>
			{dict.header.skipToContent}
		</a>

		<header class="sticky top-0 z-30 border-b border-hairline bg-canvas/85 backdrop-blur-md backdrop-saturate-150">
			<nav class="container-page flex h-16 items-center justify-between gap-2">
				<a href={getRelativeLocaleUrl(locale, "")} class="interactive flex min-w-0 shrink items-center gap-2.5 text-[15px] font-semibold tracking-tight text-ink hover:opacity-80">
					<span
						class="flex size-7 shrink-0 items-center justify-center rounded-md bg-ink text-ink-contrast shadow-sm"
						aria-hidden="true"
					>
						<OwlMark class="size-[18px]" />
					</span>
					<span class="truncate">{dict.header.brand}</span>
				</a>
				<div class="flex shrink-0 items-center gap-0.5 sm:gap-1">
					<a
						href={`${getRelativeLocaleUrl(locale, "")}#calculator`}
						class="interactive hidden rounded-md px-3 py-2 text-sm font-medium text-body hover:bg-hairline-soft hover:text-ink xs:inline-block"
					>
						{dict.header.navCalculator}
					</a>
					<a
						href={`${getRelativeLocaleUrl(locale, "")}#faq`}
						class="interactive hidden rounded-md px-3 py-2 text-sm font-medium text-body hover:bg-hairline-soft hover:text-ink sm:inline-block"
					>
						{dict.header.navFaq}
					</a>

					<div class="relative">
						<button
							type="button"
							id="lang-toggle"
							aria-haspopup="true"
							aria-expanded="false"
							aria-label={dict.header.languageLabel}
							class="interactive flex items-center gap-1 rounded-md px-2.5 py-2 text-sm font-medium text-body hover:bg-hairline-soft hover:text-ink active:scale-90"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true">
								<circle cx="12" cy="12" r="10"></circle>
								<path d="M2 12h20"></path>
								<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
							</svg>
						</button>
						<ul
							id="lang-menu"
							role="menu"
							class="absolute right-0 top-full z-20 mt-2 hidden min-w-[9rem] rounded-lg border border-hairline bg-canvas-elevated py-1.5 shadow-lg"
						>
							{Object.entries(languages).map(([loc, label]) => (
								<li role="none">
									<a
										role="menuitem"
										href={getRelativeLocaleUrl(loc, "")}
										aria-current={loc === locale ? "true" : undefined}
										class:list={[
											"interactive block px-3.5 py-2 text-sm hover:bg-hairline-soft hover:text-ink",
											loc === locale ? "font-medium text-ink" : "text-body",
										]}
									>
										{label}
									</a>
								</li>
							))}
						</ul>
					</div>

					<button
						type="button"
												aria-label={dict.header.themeToggleLabel}
						class="interactive flex size-9 items-center justify-center rounded-md text-body hover:bg-hairline-soft hover:text-ink active:scale-90"
					>
						<svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2v2"></path>
							<path d="M12 20v2"></path>
							<path d="M4.93 4.93l1.41 1.41"></path>
							<path d="M17.66 17.66l1.41 1.41"></path>
							<path d="M2 12h2"></path>
							<path d="M20 12h2"></path>
							<path d="M6.34 17.66l-1.41 1.41"></path>
							<path d="M19.07 4.93l-1.41 1.41"></path>
						</svg>
						<svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="hidden size-[18px]" aria-hidden="true">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
						</svg>
					</button>
				</div>
			</nav>
		</header>

		<main id="main-content">
			<slot />
		</main>

		<footer class="border-t border-hairline bg-canvas">
			<div class="container-page flex flex-col gap-7 py-12 text-sm text-body">
				<nav class="flex flex-wrap gap-x-7 gap-y-2.5">
					<a href={getRelativeLocaleUrl(locale, "about")} class="interactive text-body hover:text-ink">
						{dict.footer.navAbout}
					</a>
					<a href={getRelativeLocaleUrl(locale, "privacy")} class="interactive text-body hover:text-ink">
						{dict.footer.navPrivacy}
					</a>
					<a href={getRelativeLocaleUrl(locale, "terms")} class="interactive text-body hover:text-ink">
						{dict.footer.navTerms}
					</a>
					<a href={getRelativeLocaleUrl(locale, "contact")} class="interactive text-body hover:text-ink">
						{dict.footer.navContact}
					</a>
				</nav>
				<div class="flex flex-col gap-3 border-t border-hairline pt-6 sm:flex-row sm:items-center sm:justify-between">
					<p>{dict.footer.copyright.replace("{year}", String(currentYear))}</p>
					<p class="text-faint">{dict.footer.disclaimer}</p>
				</div>
			</div>
		</footer>

		<script is:inline>
			(function () {
				var toggle = document.getElementById("theme-toggle");
				var sunIcon = document.getElementById("theme-icon-sun");
				var moonIcon = document.getElementById("theme-icon-moon");
				var root = document.documentElement;

				function syncIcons() {
					var isDark = root.classList.contains("dark");
					sunIcon.classList.toggle("hidden", isDark);
					moonIcon.classList.toggle("hidden", !isDark);
				}

				syncIcons();

				toggle.addEventListener("click", function () {
					var isDark = root.classList.toggle("dark");
					localStorage.setItem("theme", isDark ? "dark" : "light");
					syncIcons();
				});

				var langToggle = document.getElementById("lang-toggle");
				var langMenu = document.getElementById("lang-menu");

				function closeMenu() {
					langMenu.classList.add("hidden");
					langToggle.setAttribute("aria-expanded", "false");
				}

				langToggle.addEventListener("click", function (e) {
					e.stopPropagation();
					var isHidden = langMenu.classList.contains("hidden");
					langMenu.classList.toggle("hidden", !isHidden);
					langToggle.setAttribute("aria-expanded", String(isHidden));
				});

				document.addEventListener("click", function (e) {
					if (!langMenu.contains(e.target) && e.target !== langToggle) {
						closeMenu();
					}
				});

				document.addEventListener("keydown", function (e) {
					if (e.key === "Escape") closeMenu();
				});
			})();
		</script>

		<script>
			// Fades below-the-fold sections in as they scroll into view. No-JS and
			// reduced-motion visitors always see full content (see global.css).
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");

			if (!("IntersectionObserver" in window) || reduceMotion) {
				targets.forEach((el) => el.classList.add("is-visible"));
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								io.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
				);
				targets.forEach((el) => io.observe(el));
			}
		</script>

		<!-- Google tag (gtag.js) -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-Z0GXQBS72C');
		</script>
		<script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-Z0GXQBS72C"></script>

		<!-- Google AdSense -->
		<script async is:inline src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6778789012514648"
			crossorigin="anonymous"></script>
	</body>
</html>
