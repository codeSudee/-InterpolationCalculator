---
import "../styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { languages, locales, defaultLocale, type Locale } from "../i18n/languages";
import { getDictionary } from "../i18n/utils";
import { landingPages } from "../data/landing-pages";

interface Props {
	locale: Locale;
	title?: string;
	description?: string;
	currentPath?: string;
	/** Adds a robots noindex tag and drops the canonical and hreflang links (error pages). */
	noindex?: boolean;
	/** Set false for pages that only exist in one language, so no hreflang alternates are emitted. */
	alternates?: boolean;
	/** Structured data objects to emit as JSON-LD. Only pass what is visible on the page. */
	jsonLd?: object[];
}

const { locale, title, description, currentPath = "/", noindex = false, alternates = true, jsonLd = [] } = Astro.props;
const dict = getDictionary(locale);

const pageTitle = title ?? dict.meta.title;
const pageDescription = description ?? dict.meta.description;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang={locale}>
	<head>
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem("theme");
					var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
					var isDark = stored === "dark" || (stored !== "light" && prefersDark);
					document.documentElement.classList.toggle("dark", isDark);
				} catch (e) {}
				document.documentElement.classList.add("js-reveal");
			})();
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="interpolation" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}

		{!noindex && alternates && locales.map((loc) => (
			<link rel="alternate" hreflang={loc} href={new URL(getRelativeLocaleUrl(loc, currentPath === "/" ? "" : currentPath), Astro.site)} />
		))}
		{!noindex && alternates && <link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl(defaultLocale, ""), Astro.site)} />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Interpolation Calculator Online" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
		<meta property="og:locale" content={locale} />
		<meta property="og:image" content={new URL("/web-app-manifest-512x512.png", Astro.site)} />
		<meta property="og:image:width" content="512" />
		<meta property="og:image:height" content="512" />
		<meta property="og:image:alt" content={pageTitle} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={new URL("/web-app-manifest-512x512.png", Astro.site)} />

		{jsonLd.map((data) => (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
		))}

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="preload"
			as="style"
			href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
			rel="stylesheet"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
				rel="stylesheet"
			/>
		</noscript>
	</head>
	<body class="bg-canvas text-ink antialiased">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-3.5 focus:py-2 focus:text-ink-contrast focus:shadow-lg"
		>
			{dict.header.skipToContent}
		</a>

		<header class="sticky top-0 z-30 border-b border-hairline bg-canvas/85 backdrop-blur-md backdrop-saturate-150">
			<nav class="container-page flex h-16 items-center justify-between gap-2">
				<a href={getRelativeLocaleUrl(locale, "")} class="interactive flex min-w-0 shrink items-center gap-2.5 text-[15px] font-semibold tracking-tight text-ink hover:opacity-80">
					<span
						class="flex size-7 shrink-0 items-center justify-center rounded-md bg-ink text-[14px] font-semibold text-ink-contrast shadow-sm"
						aria-hidden="true"
					>
						∫
					</span>
					<span class="truncate">{dict.header.brand}</span>
				</a>
				<div class="flex shrink-0 items-center gap-0.5 sm:gap-1">
					<a
						href={`${getRelativeLocaleUrl(locale, "")}#calculator`}
						class="interactive hidden rounded-md px-3 py-2 text-sm font-medium text-body hover:bg-hairline-soft hover:text-ink xs:inline-block"
					>
						{dict.header.navCalculator}
					</a>
					<a
						href={`${getRelativeLocaleUrl(locale, "")}#faq`}
						class="interactive hidden rounded-md px-3 py-2 text-sm font-medium text-body hover:bg-hairline-soft hover:text-ink sm:inline-block"
					>
						{dict.header.navFaq}
					</a>

					<div class="relative">
						<button
							type="button"
							id="lang-toggle"
							aria-haspopup="true"
							aria-expanded="false"
							aria-label={dict.header.languageLabel}
							class="interactive flex items-center gap-1 rounded-md px-2.5 py-2 text-sm font-medium text-body hover:bg-hairline-soft hover:text-ink active:scale-90"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true">
								<circle cx="12" cy="12" r="10"></circle>
								<path d="M2 12h20"></path>
								<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
							</svg>
						</button>
						<ul
							id="lang-menu"
							role="menu"
							class="absolute right-0 top-full z-20 mt-2 hidden min-w-[9rem] rounded-lg border border-hairline bg-canvas-elevated py-1.5 shadow-lg"
						>
							{Object.entries(languages).map(([loc, label]) => (
								<li role="none">
									<a
										role="menuitem"
										href={getRelativeLocaleUrl(loc, "")}
										aria-current={loc === locale ? "true" : undefined}
										class:list={[
											"interactive block px-3.5 py-2 text-sm hover:bg-hairline-soft hover:text-ink",
											loc === locale ? "font-medium text-ink" : "text-body",
										]}
									>
										{label}
									</a>
								</li>
							))}
						</ul>
					</div>

					<button
						type="button"
						id="theme-toggle"
						aria-label={dict.header.themeToggleLabel}
						class="interactive flex size-9 items-center justify-center rounded-md text-body hover:bg-hairline-soft hover:text-ink active:scale-90"
					>
						<svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2v2"></path>
							<path d="M12 20v2"></path>
							<path d="M4.93 4.93l1.41 1.41"></path>
							<path d="M17.66 17.66l1.41 1.41"></path>
							<path d="M2 12h2"></path>
							<path d="M20 12h2"></path>
							<path d="M6.34 17.66l-1.41 1.41"></path>
							<path d="M19.07 4.93l-1.41 1.41"></path>
						</svg>
						<svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="hidden size-[18px]" aria-hidden="true">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
						</svg>
					</button>
				</div>
			</nav>
		</header>

		<main id="main-content">
			<slot />
		</main>

		<footer class="border-t border-hairline bg-canvas">
			<div class="container-page flex flex-col gap-7 py-12 text-sm text-body">
				{locale === "en" && (
					<nav aria-label="Calculators" class="flex flex-wrap gap-x-7 gap-y-2.5">
						{landingPages.map((page) => (
							<a href={`/${page.slug}/`} class="interactive text-body hover:text-ink">
								{page.nav}
							</a>
						))}
					</nav>
				)}
				<nav class="flex flex-wrap gap-x-7 gap-y-2.5">
					<a href={getRelativeLocaleUrl(locale, "about")} class="interactive text-body hover:text-ink">
						{dict.footer.navAbout}
					</a>
					<a href={getRelativeLocaleUrl(locale, "privacy")} class="interactive text-body hover:text-ink">
						{dict.footer.navPrivacy}
					</a>
					<a href={getRelativeLocaleUrl(locale, "terms")} class="interactive text-body hover:text-ink">
						{dict.footer.navTerms}
					</a>
					<a href={getRelativeLocaleUrl(locale, "contact")} class="interactive text-body hover:text-ink">
						{dict.footer.navContact}
					</a>
				</nav>
				<div class="flex flex-col gap-3 border-t border-hairline pt-6 sm:flex-row sm:items-center sm:justify-between">
					<p>{dict.footer.copyright.replace("{year}", String(currentYear))}</p>
					<p class="text-faint">{dict.footer.disclaimer}</p>
				</div>
			</div>
		</footer>

		<script is:inline>
			(function () {
				var toggle = document.getElementById("theme-toggle");
				var sunIcon = document.getElementById("theme-icon-sun");
				var moonIcon = document.getElementById("theme-icon-moon");
				var root = document.documentElement;

				function syncIcons() {
					var isDark = root.classList.contains("dark");
					sunIcon.classList.toggle("hidden", isDark);
					moonIcon.classList.toggle("hidden", !isDark);
				}

				syncIcons();

				toggle.addEventListener("click", function () {
					var isDark = root.classList.toggle("dark");
					localStorage.setItem("theme", isDark ? "dark" : "light");
					syncIcons();
				});

				var langToggle = document.getElementById("lang-toggle");
				var langMenu = document.getElementById("lang-menu");

				function closeMenu() {
					langMenu.classList.add("hidden");
					langToggle.setAttribute("aria-expanded", "false");
				}

				langToggle.addEventListener("click", function (e) {
					e.stopPropagation();
					var isHidden = langMenu.classList.contains("hidden");
					langMenu.classList.toggle("hidden", !isHidden);
					langToggle.setAttribute("aria-expanded", String(isHidden));
				});

				document.addEventListener("click", function (e) {
					if (!langMenu.contains(e.target) && e.target !== langToggle) {
						closeMenu();
					}
				});

				document.addEventListener("keydown", function (e) {
					if (e.key === "Escape") closeMenu();
				});
			})();
		</script>

		<script>
			// Lenis smooth scroll driven by GSAP's ticker, plus GSAP ScrollTrigger
			// reveals for below-the-fold sections. No-JS and reduced-motion visitors
			// always see full content (see global.css).
			import Lenis from "lenis";
			import { gsap } from "gsap";
			import { ScrollTrigger } from "gsap/ScrollTrigger";

			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const targets = gsap.utils.toArray<HTMLElement>("[data-reveal]");

			if (reduceMotion) {
				targets.forEach((el) => el.classList.add("is-visible"));
			} else {
				gsap.registerPlugin(ScrollTrigger);

				const lenis = new Lenis({ respectReducedMotion: true, anchors: true });
				lenis.on("scroll", ScrollTrigger.update);
				gsap.ticker.add((time) => lenis.raf(time * 1000));
				gsap.ticker.lagSmoothing(0);

				// Siblings that share a parent (e.g. a row of cards) enter the viewport
				// at the same scroll position, so stagger them slightly.
				const siblingCounts = new Map<Element, number>();
				targets.forEach((el) => {
					const parent = el.parentElement ?? document.body;
					const index = siblingCounts.get(parent) ?? 0;
					siblingCounts.set(parent, index + 1);

					gsap.fromTo(
						el,
						{ opacity: 0, y: 24 },
						{
							opacity: 1,
							y: 0,
							duration: 0.7,
							delay: Math.min(index, 3) * 0.09,
							ease: "power2.out",
							// Hand control back to CSS (.is-visible) once finished.
							onComplete: () => {
								el.classList.add("is-visible");
								gsap.set(el, { clearProps: "opacity,transform" });
							},
							scrollTrigger: { trigger: el, start: "top 90%", once: true },
						},
					);
				});

				// Gentle entrance for the hero copy. Opacity is left alone on the
				// headline so the largest-contentful-paint text is never hidden.
				gsap.from("[data-hero]:not(h1)", { opacity: 0, y: 14, duration: 0.6, stagger: 0.1, ease: "power3.out", clearProps: "all" });
				gsap.from("h1[data-hero]", { y: 14, duration: 0.6, ease: "power3.out", clearProps: "all" });
			}
		</script>

		<!-- Google tag (gtag.js) -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-Z0GXQBS72C');
		</script>
		<script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-Z0GXQBS72C"></script>

		<!-- Google AdSense -->
		<script async is:inline src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6778789012514648"
			crossorigin="anonymous"></script>
	</body>
</html>
