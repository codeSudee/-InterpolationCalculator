---
import Layout from "../layouts/Layout.astro";
import InterpolationCalculator from "../components/InterpolationCalculator.astro";
import { getDictionary } from "../i18n/utils";
import { landingPages, getLandingPage } from "../data/landing-pages";

export function getStaticPaths() {
	return landingPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const dict = getDictionary("en");
const site = Astro.site!;
const pageUrl = new URL(`/${page.slug}/`, site).toString();
const related = page.related.map((slug) => getLandingPage(slug)).filter((p) => p !== undefined);

// Splits a paragraph on the [text](/path/) and `code` markup used in landing-page section bodies.
function parseInline(text: string) {
	return text.split(/(\[[^\]]+\]\(\/[^)]*\)|`[^`]+`)/).map((part) => {
		const link = part.match(/^\[([^\]]+)\]\((\/[^)]*)\)$/);
		if (link) return { kind: "link" as const, text: link[1], href: link[2] };
		if (part.startsWith("`") && part.endsWith("`") && part.length > 1) return { kind: "code" as const, text: part.slice(1, -1) };
		return { kind: "text" as const, text: part };
	});
}

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "WebApplication",
		name: page.h1,
		url: pageUrl,
		applicationCategory: "UtilitiesApplication",
		operatingSystem: "Any (runs in browser)",
		description: page.description,
		inLanguage: "en",
		offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "Interpolation Calculator", item: new URL("/", site).toString() },
			{ "@type": "ListItem", position: 2, name: page.h1, item: pageUrl },
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: page.faqs.map((faq) => ({
			"@type": "Question",
			name: faq.q,
			acceptedAnswer: { "@type": "Answer", text: faq.a },
		})),
	},
];
---

<Layout locale="en" title={page.title} description={page.description} currentPath={page.slug} alternates={false} jsonLd={jsonLd}>
	<section class="container-page pt-10 sm:pt-14">
		<nav aria-label="Breadcrumb" class="text-sm text-mute">
			<!-- One line that truncates rather than wraps, so the web-font swap cannot add a line and shift the page. -->
			<ol class="flex flex-nowrap items-center gap-x-2">
				<li class="shrink-0"><a href="/" class="interactive whitespace-nowrap underline-offset-4 hover:text-ink hover:underline">Interpolation Calculator</a></li>
				<li aria-hidden="true" class="shrink-0">/</li>
				<li aria-current="page" class="min-w-0 truncate text-body">{page.h1}</li>
			</ol>
		</nav>
		<h1 class="mt-5 max-w-3xl text-3xl font-semibold tracking-tight text-ink text-balance sm:text-4xl" style="letter-spacing: var(--tracking-display);">
			{page.h1}
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-relaxed text-body sm:text-lg">{page.intro}</p>
		<p class="mt-3 max-w-2xl text-sm text-mute">{page.presetNote}</p>
	</section>

	<div class="py-10 sm:py-12">
		<InterpolationCalculator dict={dict} preset={page.preset} resultClass={page.reserve} clearLabel="Clear fields" />
	</div>

	<section class="container-page py-10 sm:py-14">
		<div class="mx-auto max-w-3xl">
			<div class="space-y-9">
				{page.sections.map((section) => (
					<div>
						<h2 class="text-xl font-semibold tracking-tight text-ink sm:text-2xl" style="letter-spacing: var(--tracking-heading);">{section.heading}</h2>
						{section.body.map((paragraph) => (
							<p class="mt-3 text-sm leading-relaxed text-body sm:text-base">
								{parseInline(paragraph).map((part) =>
									part.kind === "link" ? (
										<a href={part.href} class="interactive text-link underline underline-offset-4 hover:text-link-deep">{part.text}</a>
									) : part.kind === "code" ? (
										<code class="rounded border border-hairline bg-hairline-soft px-1 py-0.5 font-mono text-xs text-ink">{part.text}</code>
									) : (
										part.text
									),
								)}
							</p>
						))}
						{section.steps && (
							<ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-body sm:text-base">
								{section.steps.map((step) => <li>{step}</li>)}
							</ol>
						)}
						{section.table && (
							<div class="mt-4 overflow-x-auto rounded-lg border border-hairline">
								<table class="w-full border-collapse text-left text-sm">
									<thead class="bg-hairline-soft text-ink">
										<tr>
											{section.table.headers.map((header) => <th scope="col" class="px-3.5 py-2.5 font-medium">{header}</th>)}
										</tr>
									</thead>
									<tbody class="divide-y divide-hairline text-body">
										{section.table.rows.map((row) => (
											<tr>
												{row.map((cell, i) => (i === 0 ? <th scope="row" class="px-3.5 py-2.5 font-medium text-ink">{cell}</th> : <td class="px-3.5 py-2.5">{cell}</td>))}
											</tr>
										))}
									</tbody>
								</table>
							</div>
						)}
						{section.code?.map((formula) => (
							<pre class="mt-4 whitespace-pre-wrap break-words rounded-md border border-hairline bg-hairline-soft px-3.5 py-2.5 font-mono text-xs leading-relaxed text-ink"><code>{formula}</code></pre>
						))}
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="container-page py-10 sm:py-14">
		<div class="mx-auto max-w-3xl">
			<h2 class="text-xl font-semibold tracking-tight text-ink sm:text-2xl" style="letter-spacing: var(--tracking-heading);">Frequently asked questions</h2>
			<div class="mt-6 divide-y divide-hairline rounded-lg border border-hairline">
				{page.faqs.map((item) => (
					<details class="group px-5 py-4 first:rounded-t-lg last:rounded-b-lg open:bg-hairline-soft/60 sm:px-6">
						<summary class="interactive flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium text-ink marker:content-none">
							{item.q}
							<span class="flex size-5 shrink-0 items-center justify-center text-mute transition-transform duration-200 ease-[var(--ease-standard)] group-open:rotate-45" aria-hidden="true">+</span>
						</summary>
						<p class="mt-2.5 text-sm leading-relaxed text-body">{item.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="container-page pb-14 pt-6 sm:pb-20">
		<div class="mx-auto max-w-3xl">
			<h2 class="text-base font-semibold tracking-tight text-ink">Related calculators and guides</h2>
			<ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
				{related.map((r) => (
					<li><a href={`/${r.slug}/`} class="interactive text-link underline-offset-4 hover:text-link-deep hover:underline">{r.nav}</a></li>
				))}
				<li><a href="/" class="interactive text-link underline-offset-4 hover:text-link-deep hover:underline">All three methods on the home page</a></li>
			</ul>
		</div>
	</section>
</Layout>
